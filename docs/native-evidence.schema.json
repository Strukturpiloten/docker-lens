{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DockerLens reviewed native capability record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lane",
    "candidate_sha",
    "run_url",
    "native_manifest_artifact_name",
    "native_manifest_sha256",
    "identity",
    "capabilities"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "lane": {
      "enum": ["debian11-rootful", "debian11-rootless", "upstream-rootful", "upstream-rootless"]
    },
    "candidate_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "run_url": {
      "type": "string",
      "pattern": "^https://github\\.com/Strukturpiloten/docker-lens/actions/runs/[1-9][0-9]*/attempts/[1-9][0-9]*$"
    },
    "native_manifest_artifact_name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "native_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build",
        "engine_release",
        "advertised_api",
        "acquisition_api",
        "rendering_api",
        "mode"
      ],
      "properties": {
        "build": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": { "kind": { "const": "upstream" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "distribution", "package_name", "package_revision"],
              "properties": {
                "kind": { "const": "debian-package" },
                "distribution": { "const": "debian11" },
                "package_name": { "const": "docker.io" },
                "package_revision": { "const": "20.10.5+dfsg1-1+deb11u2" }
              }
            }
          ]
        },
        "engine_release": { "type": "string", "minLength": 1 },
        "advertised_api": { "$ref": "#/$defs/api_version" },
        "acquisition_api": { "$ref": "#/$defs/api_version" },
        "rendering_api": { "$ref": "#/$defs/api_version" },
        "mode": { "enum": ["rootful", "rootless"] }
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "state", "admitted_shapes"],
        "properties": {
          "name": {
            "enum": [
              "StandaloneContainer", "BindMount", "BindRelabelShared", "BindRelabelPrivate",
              "TmpfsMount", "NamedVolume",
              "VolumeLabels", "VolumeExternalReference", "BridgeNetwork",
              "NetworkExternalReference", "NetworkExternalInternalExpectation", "NetworkInternal", "NetworkIpv6",
              "NetworkIpam", "NetworkIpamDriver", "NetworkOptions", "NetworkLabels",
              "NetworkAliases", "NetworkStaticAddress", "NetworkMultipleAttachment",
              "HostNetwork", "PortPublish", "PortExposeOnly", "PortHostIpv4",
              "PortHostIpv6", "PortMultipleBindings", "PortEphemeral", "UserNamespace",
              "EnvironmentAssignment", "Command", "CommandClear", "Entrypoint",
              "EntrypointClear", "Healthcheck", "HealthShell", "HealthDisabled",
              "HealthStartPeriod", "HealthStartInterval", "RestartPolicy",
              "ContainerLabels", "ContainerUser", "ContainerWorkdir", "ContainerHostname",
              "ReadOnlyRootfs", "ContainerInit", "StopSignal", "StopTimeout",
              "MemoryLimit", "PidsLimit", "ShmSize", "Ulimits", "UlimitNofile",
              "DeviceMappings", "LinuxCapabilities", "CapAddNetBindService",
              "CapDropSysAdmin", "SecurityOptions", "Sysctls", "SysctlIpv4Forward",
              "SupplementaryGroups", "DnsServers", "ExtraHosts", "LogConfig",
              "LogOptionMaxSize"
            ]
          },
          "state": { "enum": ["available", "unavailable", "unknown"] },
          "admitted_shapes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "StandaloneCreate", "NamedVolumeCreate", "VolumeCreateLabels",
                "NamedVolumeMountReadWrite", "NamedVolumeMountReadOnly",
                "ExternalVolumeReference", "BridgeNetworkCreate", "BridgeNetworkAttach",
                "ExternalNetworkReference", "ExternalNetworkInternalFalse", "ExternalNetworkInternalTrue", "InternalBridgeNetworkCreate",
                "Ipv6BridgeNetworkCreate", "NetworkIpamV4", "NetworkIpamV6",
                "NetworkIpamGateway", "NetworkIpamRange", "NetworkIpamAuxiliary",
                "NetworkIpamDefaultDriver", "NetworkBridgeMtu", "NetworkBridgeIcc",
                "NetworkBridgeIccDisabled", "NetworkBridgeMasquerade",
                "NetworkBridgeMasqueradeEnabled", "NetworkBridgeHostBindingIp",
                "NetworkCreateLabels", "NetworkPrimaryAliases", "NetworkSecondaryAliases",
                "NetworkStaticIpv4", "NetworkStaticIpv6", "NetworkSecondaryConnect",
                "FixedTcpPort", "FixedUdpPort", "ExposedOnlyPort", "FixedIpv4HostPort",
                "EphemeralIpv4HostPort", "FixedIpv6HostPort", "EphemeralIpv6HostPort",
                "MultipleFixedPortBindings", "MultipleEphemeralPortBindings",
                "EphemeralHostPort", "BindMountReadWrite", "BindMountReadOnly",
                "BindMountSharedRelabelReadWrite", "BindMountSharedRelabelReadOnly",
                "BindMountPrivateRelabelReadWrite", "BindMountPrivateRelabelReadOnly",
                "TmpfsMountReadWrite", "TmpfsMountReadOnly", "TmpfsMountOptions",
                "EnvironmentValue", "EnvironmentEmptyValue", "ExecCommand", "ClearCommand",
                "ExecEntrypoint", "ClearEntrypoint", "ExecHealthcheck", "ShellHealthcheck",
                "DisabledHealthcheck", "HealthStartPeriodZero", "HealthStartPeriodPositive",
                "HealthStartIntervalZero", "HealthStartIntervalPositive",
                "ContainerCreateLabels", "ContainerUser", "ContainerWorkdir",
                "ContainerHostname", "ReadOnlyRootfsTrue", "ReadOnlyRootfsFalse",
                "ContainerInitTrue", "ContainerInitFalse", "StopSignal", "StopTimeoutZero",
                "StopTimeoutPositive", "MemoryBytes", "MemoryUnlimited", "PidsCount",
                "PidsUnlimited", "ShmSize", "UlimitsFinite", "UlimitsUnlimited",
                "UlimitNofile", "DeviceMappings", "LinuxCapAdd", "LinuxCapDrop",
                "CapAddNetBindService", "CapDropSysAdmin", "NoNewPrivilegesEnabled",
                "NoNewPrivilegesDisabled", "Sysctls", "SysctlIpv4Forward",
                "SupplementaryGroups", "DnsIpv4", "DnsIpv6", "ExtraHostsIpv4",
                "ExtraHostsIpv6", "LogJsonFile", "LogLocal", "LogNone", "LogOptions",
                "LogOptionMaxSize", "RestartNo", "RestartAlways", "RestartUnlessStopped",
                "RestartOnFailureUnlimited", "RestartOnFailureLimited"
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "external_network_probes": {
      "description": "Ordered public projection after complete private external-network proof; never sealed admission.",
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "prefixItems": [
        { "const": "ExternalNetworkInternalFalse" },
        { "const": "ExternalNetworkInternalTrue" }
      ],
      "items": false
    },
    "external_network_projection": {
      "description": "Disconnected raw-manifest subset, not part of the reviewed-record root contract.",
      "type": "object",
      "additionalProperties": false,
      "required": ["external_network_contract", "external_network_probes"],
      "properties": {
        "external_network_contract": { "const": "external-network-internal-v1" },
        "external_network_probes": { "$ref": "#/$defs/external_network_probes" }
      }
    },
    "api_version": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+$" },
    "bind_relabel_capability_vocabulary": {
      "description": "Configured-retention vocabulary; only exact independently reviewed cohorts authorize admission.",
      "type": "string",
      "enum": ["BindRelabelShared", "BindRelabelPrivate"]
    },
    "bind_relabel_shape_vocabulary": {
      "description": "RO/RW configured-retention vocabulary; schema recognition alone is not admission or SELinux effect evidence.",
      "type": "string",
      "enum": [
        "BindMountSharedRelabelReadWrite", "BindMountSharedRelabelReadOnly",
        "BindMountPrivateRelabelReadWrite", "BindMountPrivateRelabelReadOnly"
      ]
    },
    "identity_container_v2": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "id", "name", "owner", "configured", "outcome", "rejection_phase",
                   "runtime_uid", "runtime_gid", "runtime_workdir", "cleanup"],
      "properties": {
        "role": { "enum": ["oracle", "rendered"] },
        "id": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "name": { "type": "string", "pattern": "^dl-identity-[a-zA-Z0-9]{8}-(inherit|numeric_uid_gid|numeric_uid|named_user|named_user_group|named_user_numeric_group|numeric_user_named_group|missing_user|missing_group|nondirectory_workdir)-(oracle|rendered)$" },
        "owner": { "type": "string", "pattern": "^[a-zA-Z0-9]{8}$" },
        "configured": { "enum": ["passed", "not_created"] },
        "outcome": { "enum": ["exited_zero", "missing_user", "missing_group", "workdir_not_directory"] },
        "rejection_phase": { "enum": [null, "create", "start"] },
        "runtime_uid": { "enum": ["passed", "not_started"] },
        "runtime_gid": { "enum": ["passed", "not_started"] },
        "runtime_workdir": { "enum": ["passed", "not_started"] },
        "cleanup": { "const": "absent" }
      },
      "allOf": [
        {
          "if": { "properties": { "rejection_phase": { "const": "create" } } },
          "then": { "properties": { "id": { "type": "null" }, "configured": { "const": "not_created" } } }
        },
        {
          "if": { "properties": { "outcome": { "const": "exited_zero" } } },
          "then": { "properties": { "id": { "type": "string" }, "configured": { "const": "passed" },
                    "rejection_phase": { "const": null }, "runtime_uid": { "const": "passed" },
                    "runtime_gid": { "const": "passed" }, "runtime_workdir": { "const": "passed" } } },
          "else": { "properties": { "rejection_phase": { "enum": ["create", "start"] },
                    "runtime_uid": { "const": "not_started" }, "runtime_gid": { "const": "not_started" },
                    "runtime_workdir": { "const": "not_started" } } }
        },
        {
          "if": { "properties": { "id": { "type": "null" } } },
          "then": { "properties": { "configured": { "const": "not_created" }, "rejection_phase": { "const": "create" } } },
          "else": { "properties": { "configured": { "const": "passed" } } }
        }
      ]
    },
    "identity_case_v2": {
      "type": "object", "additionalProperties": false,
      "required": ["case", "expected_outcome", "wire", "containers"],
      "properties": {
        "case": { "type": "string" }, "expected_outcome": { "type": "string" }, "wire": { "const": "passed" },
        "containers": {
          "type": "array", "minItems": 2, "maxItems": 2, "items": false,
          "prefixItems": [
            { "allOf": [{ "$ref": "#/$defs/identity_container_v2" }, { "properties": { "role": { "const": "oracle" } } }] },
            { "allOf": [{ "$ref": "#/$defs/identity_container_v2" }, { "properties": { "role": { "const": "rendered" } } }] }
          ]
        }
      },
      "allOf": [
        { "if": { "properties": { "expected_outcome": { "const": "exited_zero" } } }, "then": { "properties": { "containers": { "items": { "properties": { "outcome": { "const": "exited_zero" } } } } } } },
        { "if": { "properties": { "expected_outcome": { "const": "missing_user" } } }, "then": { "properties": { "containers": { "items": { "properties": { "outcome": { "const": "missing_user" } } } } } } },
        { "if": { "properties": { "expected_outcome": { "const": "missing_group" } } }, "then": { "properties": { "containers": { "items": { "properties": { "outcome": { "const": "missing_group" } } } } } } },
        { "if": { "properties": { "expected_outcome": { "const": "workdir_not_directory" } } }, "then": { "properties": { "containers": { "items": { "properties": { "outcome": { "const": "workdir_not_directory" } } } } } } }
      ]
    },
    "native_identity_proof_v2": {
      "description": "Private parameterized identity proof. The emitter additionally verifies file privacy/stability, globally distinct IDs, exact case/role/name/owner and candidate/lane/mode/API/run bindings, and matching rejection phases. Raw evidence only, not reviewed-catalogue admission.",
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "candidate_sha", "lane", "mode", "rendering_api", "run_id", "identity_contract", "cases", "probes"],
      "properties": {
        "schema_version": { "const": 2 }, "identity_contract": { "const": "container-identity-v1" },
        "candidate_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "lane": { "enum": ["debian11-rootful", "debian11-rootless", "upstream-rootful", "upstream-rootless"] },
        "mode": { "enum": ["rootful", "rootless"] }, "rendering_api": { "$ref": "#/$defs/api_version" },
        "run_id": { "type": "string", "pattern": "^[a-zA-Z0-9]{8}$" },
        "probes": { "$ref": "#/$defs/identity_probes" },
        "cases": {
          "type": "array", "minItems": 10, "maxItems": 10, "items": false,
          "prefixItems": [
            { "allOf": [{ "$ref": "#/$defs/identity_case_v2" }, { "properties": { "case": { "const": "inherit" }, "expected_outcome": { "const": "exited_zero" } } }] },
            { "allOf": [{ "$ref": "#/$defs/identity_case_v2" }, { "properties": { "case": { "const": "numeric_uid_gid" }, "expected_outcome": { "const": "exited_zero" } } }] },
            { "allOf": [{ "$ref": "#/$defs/identity_case_v2" }, { "properties": { "case": { "const": "numeric_uid" }, "expected_outcome": { "const": "exited_zero" } } }] },
            { "allOf": [{ "$ref": "#/$defs/identity_case_v2" }, { "properties": { "case": { "const": "named_user" }, "expected_outcome": { "const": "exited_zero" } } }] },
            { "allOf": [{ "$ref": "#/$defs/identity_case_v2" }, { "properties": { "case": { "const": "named_user_group" }, "expected_outcome": { "const": "exited_zero" } } }] },
            { "allOf": [{ "$ref": "#/$defs/identity_case_v2" }, { "properties": { "case": { "const": "named_user_numeric_group" }, "expected_outcome": { "const": "exited_zero" } } }] },
            { "allOf": [{ "$ref": "#/$defs/identity_case_v2" }, { "properties": { "case": { "const": "numeric_user_named_group" }, "expected_outcome": { "const": "exited_zero" } } }] },
            { "allOf": [{ "$ref": "#/$defs/identity_case_v2" }, { "properties": { "case": { "const": "missing_user" }, "expected_outcome": { "const": "missing_user" } } }] },
            { "allOf": [{ "$ref": "#/$defs/identity_case_v2" }, { "properties": { "case": { "const": "missing_group" }, "expected_outcome": { "const": "missing_group" } } }] },
            { "allOf": [{ "$ref": "#/$defs/identity_case_v2" }, { "properties": { "case": { "const": "nondirectory_workdir" }, "expected_outcome": { "const": "workdir_not_directory" } } }] }
          ]
        }
      }
    },
    "identity_probes": {
      "description": "Closed raw-manifest process-identity group; not capability admission.",
      "type": "array", "minItems": 5, "maxItems": 5,
      "prefixItems": [
        { "const": "ContainerUser" }, { "const": "ContainerWorkdir" },
        { "const": "ContainerNumericUidGid" },
        { "const": "ContainerProcessWorkingDirectory" },
        { "const": "ContainerIdentityOwnershipCleanup" }
      ],
      "items": false
    },
    "identity_container_proof": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "id", "name", "owner", "configured_user", "configured_workdir",
                   "runtime_uid", "runtime_gid", "runtime_workdir", "cleanup"],
      "properties": {
        "role": { "enum": ["oracle", "rendered"] },
        "id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "name": { "type": "string", "pattern": "^dl-identity-[a-zA-Z0-9]{8}-(oracle|rendered)$" },
        "owner": { "type": "string", "pattern": "^[a-zA-Z0-9]{8}$" },
        "configured_user": { "const": "passed" },
        "configured_workdir": { "const": "passed" },
        "runtime_uid": { "const": "passed" }, "runtime_gid": { "const": "passed" },
        "runtime_workdir": { "const": "passed" }, "cleanup": { "const": "absent" }
      }
    },
    "native_identity_proof": {
      "description": "Private harness proof. The emitter additionally verifies filesystem privacy, distinct IDs and exact external candidate/run/lane/mode/API bindings; this is not cryptographic attestation.",
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "candidate_sha", "lane", "mode", "rendering_api", "run_id", "probes", "containers"],
      "properties": {
        "schema_version": { "const": 1 },
        "candidate_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "lane": { "enum": ["debian11-rootful", "debian11-rootless", "upstream-rootful", "upstream-rootless"] },
        "mode": { "enum": ["rootful", "rootless"] },
        "rendering_api": { "$ref": "#/$defs/api_version" },
        "run_id": { "type": "string", "pattern": "^[a-zA-Z0-9]{8}$" },
        "probes": { "$ref": "#/$defs/identity_probes" },
        "containers": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "prefixItems": [
            { "allOf": [{ "$ref": "#/$defs/identity_container_proof" }, { "properties": { "role": { "const": "oracle" } } }] },
            { "allOf": [{ "$ref": "#/$defs/identity_container_proof" }, { "properties": { "role": { "const": "rendered" } } }] }
          ],
          "items": false
        }
      }
    },
    "port_shape": {
      "enum": [
        "FixedIpv4HostPort", "EphemeralIpv4HostPort", "FixedIpv6HostPort",
        "EphemeralIpv6HostPort", "MultipleFixedPortBindings",
        "MultipleEphemeralPortBindings", "ExposedOnlyPort", "EphemeralHostPort"
      ]
    },
    "port_probe_entry": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["shape", "outcome"],
          "properties": { "shape": { "$ref": "#/$defs/port_shape" }, "outcome": { "const": "observed" } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["shape", "outcome", "reason"],
          "properties": {
            "shape": { "enum": ["FixedIpv6HostPort", "EphemeralIpv6HostPort"] },
            "outcome": { "const": "expected_negative" },
            "reason": { "enum": ["nested_default_bridge_ipv6_unavailable", "nested_default_bridge_ipv6_runtime_binding_absent"] }
          }
        }
      ]
    },
    "port_probes": {
      "description": "Canonical sanitized native port-publication outcomes; separate from capability admission.",
      "type": "array", "minItems": 8, "maxItems": 8,
      "prefixItems": [
        { "allOf": [{ "$ref": "#/$defs/port_probe_entry" }, { "properties": { "shape": { "const": "FixedIpv4HostPort" } } }] },
        { "allOf": [{ "$ref": "#/$defs/port_probe_entry" }, { "properties": { "shape": { "const": "EphemeralIpv4HostPort" } } }] },
        { "allOf": [{ "$ref": "#/$defs/port_probe_entry" }, { "properties": { "shape": { "const": "FixedIpv6HostPort" } } }] },
        { "allOf": [{ "$ref": "#/$defs/port_probe_entry" }, { "properties": { "shape": { "const": "EphemeralIpv6HostPort" } } }] },
        { "allOf": [{ "$ref": "#/$defs/port_probe_entry" }, { "properties": { "shape": { "const": "MultipleFixedPortBindings" } } }] },
        { "allOf": [{ "$ref": "#/$defs/port_probe_entry" }, { "properties": { "shape": { "const": "MultipleEphemeralPortBindings" } } }] },
        { "allOf": [{ "$ref": "#/$defs/port_probe_entry" }, { "properties": { "shape": { "const": "ExposedOnlyPort" } } }] },
        { "allOf": [{ "$ref": "#/$defs/port_probe_entry" }, { "properties": { "shape": { "const": "EphemeralHostPort" } } }] }
      ],
      "items": false
    },
    "native_port_probe_proof": {
      "description": "Private harness proof bound by the emitter to the capture directory, candidate, lane, Engine release, API, mode and run; not cryptographic attestation.",
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "kind", "candidate_sha", "lane", "engine_release", "rendering_api", "daemon_mode", "run_id", "cleanup", "probes"],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "const": "dockerlens-native-port-probes" },
        "candidate_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "lane": { "enum": ["debian11-rootful", "debian11-rootless", "upstream-rootful", "upstream-rootless"] },
        "engine_release": { "type": "string", "minLength": 1 },
        "rendering_api": { "$ref": "#/$defs/api_version" },
        "daemon_mode": { "enum": ["rootful", "rootless"] },
        "run_id": { "type": "string", "pattern": "^[a-zA-Z0-9]{8}$" },
        "cleanup": { "const": "absent" },
        "probes": {
          "type": "object", "additionalProperties": false,
          "required": ["schema_version", "positive", "expected_negative"],
          "properties": {
            "schema_version": { "const": 1 },
            "positive": { "type": "array", "items": { "$ref": "#/$defs/port_shape" }, "uniqueItems": true },
            "expected_negative": {
              "type": "array", "items": {
                "type": "object", "additionalProperties": false,
                "required": ["shape", "reason"],
                "properties": {
                  "shape": { "enum": ["FixedIpv6HostPort", "EphemeralIpv6HostPort"] },
                  "reason": { "enum": ["nested_default_bridge_ipv6_unavailable", "nested_default_bridge_ipv6_runtime_binding_absent"] }
                }
              }, "uniqueItems": true
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "lane": { "enum": ["debian11-rootful", "debian11-rootless"] } } },
      "then": {
        "properties": {
          "identity": {
            "properties": {
              "build": { "properties": { "kind": { "const": "debian-package" } } },
              "engine_release": { "const": "20.10.5+dfsg1" },
              "advertised_api": { "const": "1.41" },
              "acquisition_api": { "const": "1.41" },
              "rendering_api": { "const": "1.41" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "lane": { "enum": ["upstream-rootful", "upstream-rootless"] } } },
      "then": {
        "properties": {
          "identity": {
            "properties": {
              "build": { "properties": { "kind": { "const": "upstream" } } },
              "engine_release": { "const": "29.8.1" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "lane": { "enum": ["debian11-rootful", "upstream-rootful"] } } },
      "then": { "properties": { "identity": { "properties": { "mode": { "const": "rootful" } } } } }
    },
    {
      "if": { "properties": { "lane": { "enum": ["debian11-rootless", "upstream-rootless"] } } },
      "then": { "properties": { "identity": { "properties": { "mode": { "const": "rootless" } } } } }
    },
    {
      "if": { "properties": { "lane": { "const": "debian11-rootful" } } },
      "then": { "properties": { "native_manifest_artifact_name": { "const": "dockerlens-native-debian11-rootful" } } }
    },
    {
      "if": { "properties": { "lane": { "const": "debian11-rootless" } } },
      "then": { "properties": { "native_manifest_artifact_name": { "const": "dockerlens-native-debian11-rootless" } } }
    },
    {
      "if": { "properties": { "lane": { "const": "upstream-rootful" } } },
      "then": { "properties": { "native_manifest_artifact_name": { "const": "dockerlens-native-upstream-rootful" } } }
    },
    {
      "if": { "properties": { "lane": { "const": "upstream-rootless" } } },
      "then": { "properties": { "native_manifest_artifact_name": { "const": "dockerlens-native-upstream-rootless" } } }
    }
  ]
}
